# Copier ce fichier en .env.local et renseigner les valeurs
# (Supabase > Project Settings > API)
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon

# Code secret de l'espace animateur (créer / lancer / supprimer un quiz).
# Attention : comme toute variable VITE_, il est visible dans le code envoyé au navigateur.
VITE_ADMIN_PIN=choisis-un-code
